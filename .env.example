# Vercel Blob. Without these the workspace runs on demo data: the fields show
# the file from the tab and say plainly that nothing was stored.

# Created by `vercel blob store add`, or copied from an existing store.
# Present but no BLOB_UPLOAD_SECRET → the handlers read, and refuse every write.
BLOB_READ_WRITE_TOKEN=

# This workspace has no users, so a write has to be gated on something. Set a
# long random string and send it as `x-upload-secret`. It stands in for the
# session and permission the application checks on every one of these routes —
# it is not equivalent to one, and is not meant for anything but a demo.
BLOB_UPLOAD_SECRET=
