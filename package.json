{
  "name": "@omnidel/shared-components",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated shared-component library + playground for OmniDel. Independent of the Next.js app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite build --ssr scripts/smoke.tsx --outDir .smoke && node .smoke/smoke.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
