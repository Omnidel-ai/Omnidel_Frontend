  "assistant": {
    "name": "MahAcharya",
    "greeting": "Ask me about anything on this screen — the masters, the shell, or what a component does.",
    "suggestions": [
      "What is this admin page driven by?",
      "How do I add a new master?",
      "Which components are shared?",
      "Is any of this connected to the backend?"
    ],
    "replies": [
      { "match": "driven", "text": "Every admin screen here is rendered from one descriptor in demo.json — its columns, its form fields and its rows. The page component itself is generic: nothing in it names a lane, a language or a mission." },
      { "match": "add a new master", "text": "Add an entry to `masters` in demo.json: a key, labels, a `columns` array and a `fields` array. It appears in the sidebar and gets a full CRUD screen with no new code." },
      { "match": "shared", "text": "Buttons, inputs, selects, the table family, filters, modals, toasts, the page header and the badges. Anything that knows a domain object — comments, rich text, CSV import — is a feature, not a shared component." },
      { "match": "backend", "text": "No. There is no fetch, no database and no auth in this workspace. Edits change in-memory state and are lost on reload, by design — the real APIs get wired once the backend split lands." },
      { "match": "shell", "text": "The shell is the sidebar, the topbar with search and notifications, the profile menu, the status bar and this assistant. All five read demo.json, so none of them hard-code a route or a person." }
    ],
    "fallback": "This is a demo assistant — it answers from a small canned set. Try one of the suggestions above, or ask about the masters, the shell, the shared components or the backend."
  },

