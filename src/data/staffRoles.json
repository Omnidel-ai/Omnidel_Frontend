{
  "roles": [
    { "key": "support", "label": "Support", "tone": "neutral", "members": 6, "summary": "Answers customers and opens support sessions" },
    { "key": "billing", "label": "Billing", "tone": "ochre", "members": 3, "summary": "Invoices, payments and account standing" },
    { "key": "admin", "label": "Admin", "tone": "green", "members": 2, "summary": "Runs customer accounts end to end" },
    { "key": "owner", "label": "Owner", "tone": "terra", "members": 1, "summary": "Everything, always — cannot be narrowed", "fixed": true }
  ],
  "groups": [
    {
      "key": "customers",
      "label": "Customers",
      "permissions": [
        { "key": "customers.read", "label": "See customers", "grants": ["support", "billing", "admin"] },
        { "key": "customers.suspend", "label": "Suspend a customer, or mark them past due", "grants": ["billing", "admin"] },
        { "key": "customers.reactivate", "label": "Reactivate a customer", "grants": ["billing", "admin"] },
        { "key": "customers.close", "label": "Begin closing a customer", "grants": ["admin"], "risk": "Serious" },
        { "key": "customers.archive", "label": "Archive a customer", "hint": "Starts the deletion countdown", "grants": ["admin"], "risk": "Destructive" }
      ]
    },
    {
      "key": "billing",
      "label": "Billing",
      "permissions": [
        { "key": "invoices.read", "label": "See invoices", "grants": ["support", "billing", "admin"] },
        { "key": "payments.record", "label": "Record a payment", "grants": ["billing", "admin"] }
      ]
    },
    {
      "key": "modules",
      "label": "Modules",
      "permissions": [
        { "key": "modules.enable", "label": "Turn a module on", "grants": ["admin"] },
        { "key": "modules.disable", "label": "Turn a module off", "grants": ["admin"] }
      ]
    },
    {
      "key": "team",
      "label": "Team & seats",
      "permissions": [
        { "key": "team.invite", "label": "Invite people to a customer's team", "grants": ["admin"] },
        { "key": "seats.give", "label": "Give a seat", "grants": ["admin"] },
        { "key": "seats.take", "label": "Take a seat away", "grants": ["admin"] }
      ]
    },
    {
      "key": "support",
      "label": "Support sessions",
      "permissions": [
        { "key": "support.open", "label": "Open a support session", "grants": ["support", "admin"] },
        { "key": "support.close", "label": "Close a support session", "grants": ["support", "admin"] }
      ]
    }
  ],
  "ownerOnly": [
    "Approve deleting a customer's data",
    "change this screen"
  ]
